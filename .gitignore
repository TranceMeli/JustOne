# .NET build output
**/bin/
**/obj/
*.user
*.suo
.vs/

# Local SQLite databases (incl. journal files), e.g. justone.db
/asp-backend/*.db
/asp-backend/*.db-shm
/asp-backend/*.db-wal

# User-uploaded content
/asp-backend/wwwroot/uploads/

# JavaScript dependencies and build output
**/node_modules/
**/dist/
**/dist-ssr/

# Local environment overrides
**/.env
**/.env.*
!**/.env.example

# Logs
*.log
logs/

# Editors and IDEs (shared VS Code settings stay tracked)
.idea/

# Claude Code: personal settings stay local, launch.json is shared
.claude/settings.local.json

# Operating system files
.DS_Store
Thumbs.db
